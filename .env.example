TELEPHONY_KIND=twilio
SCRIPT_PROVIDER_MODE=mock
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.8-27B:fastest
SUPERVISOR_READ_TOKEN=
SUPERVISOR_ACTION_TOKEN=
